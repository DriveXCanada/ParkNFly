# Set to "true" to seed the app with sample/demo data (client showcase).
# Leave unset (or "false") for a clean, empty production system.
VITE_DEMO=false

# --- Backend / data sync (Railway Postgres) --------------------------------
# Railway injects DATABASE_URL automatically when you attach a Postgres service
# to this app (reference it as ${{ Postgres.DATABASE_URL }} in Variables).
# For LOCAL development, paste a Postgres connection string here.
# If DATABASE_URL is empty, the app runs local-only (no cross-device sync).
DATABASE_URL=

# Set to "true" only when connecting via a PUBLIC/proxy Postgres URL that
# requires SSL. Leave "false" for Railway's in-project private URL.
DATABASE_SSL=false
