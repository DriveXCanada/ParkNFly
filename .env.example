# Set to "true" to seed the app with sample/demo data (client showcase).
# Leave unset (or "false") for a clean, empty production system.
VITE_DEMO=false

# --- Backend / data sync (Railway Postgres) --------------------------------
# Railway injects DATABASE_URL automatically when you attach a Postgres service
# to this app (reference it as ${{ Postgres.DATABASE_URL }} in Variables).
# For LOCAL development, paste a Postgres connection string here.
# If DATABASE_URL is empty, the app runs local-only (no cross-device sync).
DATABASE_URL=

# Set to "true" only when connecting via a PUBLIC/proxy Postgres URL that
# requires SSL. Leave "false" for Railway's in-project private URL.
DATABASE_SSL=false

# --- Authentication --------------------------------------------------------
# Secret used to sign session cookies. REQUIRED in production for sessions to
# survive restarts and work across instances. Generate a long random value,
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access code the driver tablet enters to unlock the kiosk (driver) app.
# Change this from the default before launch and share it with your drivers.
KIOSK_ACCESS_CODE=parknfly

# Bootstrap owner account, seeded on first boot (password is hashed at rest).
# Change the password before launch, or rotate it in-app afterward.
BOOTSTRAP_OWNER_EMAIL=Info@drivexcanada.com
BOOTSTRAP_OWNER_PASSWORD=Test2026!
BOOTSTRAP_OWNER_NAME=DriveX
